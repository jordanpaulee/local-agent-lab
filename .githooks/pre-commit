#!/bin/sh
# Block private infrastructure details from entering this public repo.
# [A-Za-z]:(\\)+Users also catches JSON-escaped Windows paths (C:\\\\Users) inside data files.
pattern='[A-Za-z]:(\\)+Users|[A-Za-z]:/Users/|AppData|/Users/[a-z]|\.ts\.net|\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]+\.[0-9]+|ssh-(ed25519|rsa) AAAA|Bearer [A-Za-z0-9._-]{16,}|sk-[A-Za-z0-9]{20,}|__STARNET_API_TOKEN__ *= *"'
# Names that are private in themselves (hostnames, employer) live in an untracked file, one regex per line.
private="$(git rev-parse --git-common-dir)/info/private-patterns"
if [ -s "$private" ]; then
  extra=$(grep -vE '^[[:space:]]*(#|$)' "$private" | paste -sd'|' -)
  [ -n "$extra" ] && pattern="$pattern|$extra"
else
  echo "pre-commit: warning: $private is missing; private names are not being checked." >&2
fi
files=$(git diff --cached --name-only --diff-filter=ACM | grep -v "^.githooks/")
[ -z "$files" ] && exit 0
hits=$(echo "$files" | xargs grep -nIiE "$pattern" 2>/dev/null)
if [ -n "$hits" ]; then
  echo "pre-commit: possible private data, commit blocked:"; echo "$hits"; exit 1
fi
